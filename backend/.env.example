NODE_ENV=production

# Render / Railway inject PORT automatically — do not set manually in production
# NODE_PORT=3000  (local dev fallback only)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=eyJhbGci...your-service-role-jwt

# LiveKit
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_PRO_PLAN_ID=plan_xxxxxxxxxxxx

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@medgraph.in

# Auth
JWT_SECRET=minimum-32-character-random-secret-here

# Admin panel
ADMIN_PASSWORD=change-before-deploying

# Frontend URL (for CORS — set to your deployed Flutter web URL)
FRONTEND_URL=https://your-app.example.com
